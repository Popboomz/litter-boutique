---
import type { Product } from '../data/products';
const { product } = Astro.props as { product: Product };
---

<a class="product-card" href={`/products/${product.slug}`} style={`--accent:${product.accent};--accent-soft:${product.accentSoft};`}>
  <div class="product-art">
    <div class="bag">
      <div class="bag-top"></div>
      <div class="bag-label">
        <p>Sigmö</p>
        <strong>+{product.name}</strong>
        <span>{product.code}</span>
      </div>
      <div class="bag-foot">{product.subtitle}</div>
    </div>
    <div class="material material-a"></div>
    <div class="material material-b"></div>
    <div class="grains"></div>
  </div>

  <div class="product-body">
    <div>
      <p class="product-kicker">{product.visual.material}</p>
      <h3>{product.name} <span>{product.code}</span></h3>
      <p class="product-subtitle">{product.summary}</p>
    </div>
    <div class="product-meta">
      <span>{product.weight}</span>
      <strong>${product.price.toFixed(2)}</strong>
    </div>
    <div class="product-cta">
      <span class="qty">− 1 +</span>
      <span class="button">Add to cart</span>
    </div>
  </div>
</a>

<style>
  .product-card {
    display: grid; gap: 18px; padding: 18px; border-radius: 28px; background: rgba(255,250,244,0.95);
    border: 1px solid rgba(255,255,255,0.85); box-shadow: 0 20px 40px rgba(65,63,45,0.08);
  }
  .product-art {
    position: relative; min-height: 320px; border-radius: 24px; overflow: hidden;
    background: linear-gradient(180deg, #fbf6ef 0%, var(--accent-soft) 100%);
  }
  .bag {
    position: absolute; left: 26px; top: 22px; width: 54%; height: 240px; border-radius: 20px 20px 26px 26px;
    background: linear-gradient(180deg, #fffefb 0%, #f3eadf 100%); box-shadow: 0 18px 34px rgba(84,70,45,0.12);
  }
  .bag-top { height: 52px; border-bottom: 1px solid rgba(47,57,38,0.08); background: linear-gradient(180deg, #fffdf8 0%, #f5ede4 100%); }
  .bag-label {
    margin: 18px; padding: 18px; border-radius: 18px; background: linear-gradient(180deg, var(--accent-soft), rgba(255,255,255,0.72));
  }
  .bag-label p, .bag-foot, .product-kicker { margin: 0; color: #5f675d; }
  .bag-label strong { display:block; margin-top:6px; font-size: 1.4rem; letter-spacing: -0.04em; }
  .bag-label span { display:block; margin-top:10px; font-size:2rem; font-weight:800; color: var(--accent); letter-spacing:-0.08em; }
  .bag-foot { margin: 0 18px; font-size: 0.9rem; text-transform: capitalize; }
  .grains {
    position: absolute; right: 18px; bottom: 18px; width: 42%; height: 92px; border-radius: 50% 50% 28px 28px;
    background:
      radial-gradient(circle at 20% 30%, rgba(255,255,255,0.66) 0 5px, transparent 6px),
      radial-gradient(circle at 38% 52%, rgba(255,255,255,0.55) 0 4px, transparent 5px),
      radial-gradient(circle at 58% 32%, rgba(255,255,255,0.6) 0 4px, transparent 5px),
      radial-gradient(circle at 70% 55%, rgba(255,255,255,0.58) 0 4px, transparent 5px),
      radial-gradient(circle at 82% 35%, rgba(255,255,255,0.5) 0 4px, transparent 5px),
      linear-gradient(180deg, #d8cab0 0%, #bcac8e 100%);
    box-shadow: inset 0 12px 24px rgba(255,255,255,0.2);
  }
  .material {
    position: absolute; bottom: 34px; width: 48px; height: 48px; background: rgba(117,90,54,0.22); filter: saturate(1.1);
  }
  .material-a { left: 18px; border-radius: 10px; transform: rotate(-8deg); }
  .material-b { left: 52px; bottom: 18px; border-radius: 50%; width: 32px; height: 32px; }
  .product-body h3 { margin: 8px 0 0; font-size: 2rem; letter-spacing: -0.05em; }
  .product-body h3 span { color: var(--accent); }
  .product-subtitle { margin: 8px 0 18px; color: var(--muted); line-height: 1.6; }
  .product-meta, .product-cta { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .product-meta { padding-top: 12px; border-top: 1px solid var(--line); }
  .qty { display: inline-flex; align-items: center; gap: 10px; min-height: 42px; padding: 0 16px; border-radius: 999px; border: 1px solid var(--line); }
  .product-cta .button { min-height: 42px; padding: 0 18px; }
</style>
