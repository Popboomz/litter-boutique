---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { products, site } from '../../data/products';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const related = products.filter((item) => item.slug !== product.slug).slice(0, 3);
---

<Layout title={`Sigmö ${product.name} ${product.code}`} description={product.summary}>
  <SiteHeader brand={site.brand} />
  <main class="container product-page" style={`--accent:${product.accent};--accent-soft:${product.accentSoft};`}>
    <section class="product-hero">
      <div class="gallery-card">
        <div class="gallery-main">
          <img src={product.heroImage} alt={`${product.name} product image`} />
        </div>
        <div class="thumbs">
          {product.gallery.map((image) => (
            <div class="thumb"><img src={image} alt="gallery thumbnail" /></div>
          ))}
        </div>
      </div>

      <div class="purchase-card">
        <p class="breadcrumbs">Home / Shop / Cat Litter / {product.name} {product.code}</p>
        <h1>{site.brand} +{product.name} <span>{product.code}</span></h1>
        <p class="subtitle">{product.subtitle}</p>
        <div class="price-row">
          <strong>${product.price.toFixed(2)}</strong>
          <span>★ 4.8 (1,240 reviews)</span>
        </div>
        <p class="summary">{product.summary}</p>

        <div class="selectors">
          <div>
            <label>Size</label>
            <span class="pill alt">{product.weight}</span>
          </div>
          <div>
            <label>Quantity</label>
            <span class="pill alt">− 1 +</span>
          </div>
        </div>

        <div class="actions">
          <a class="button" href="/products">Add to cart</a>
          <a class="pill subscribe" href="#">Subscribe & save 10%</a>
        </div>

        <div class="quick-features">
          {product.badges.map((badge) => <span>{badge}</span>)}
        </div>
      </div>
    </section>

    <section class="trust-row">
      <article><strong>Free shipping on orders $49+</strong><p>Delivered quickly and sustainably.</p></article>
      <article><strong>Subscribe & save</strong><p>Save 10% with recurring delivery.</p></article>
      <article><strong>Love it or return it</strong><p>30-day happiness guarantee.</p></article>
    </section>

    <section class="feature-row">
      {product.features.map((feature) => (
        <article>
          <strong>{feature.title}</strong>
          <p>{feature.text}</p>
        </article>
      ))}
    </section>

    <section class="story-block">
      <div>
        <p class="eyebrow">From {product.name.toLowerCase()}, for a better tomorrow.</p>
        <h2>{product.description}</h2>
        <div class="ingredient-pills">
          {product.ingredients.map((item) => <span>{item}</span>)}
        </div>
      </div>
      <div class="story-images">
        <img src={product.heroImage} alt="Product detail close-up" />
        <img src="/images/home-reference.jpg" alt="Lifestyle crop" />
      </div>
    </section>

    <section class="how-to">
      <h2>How to use</h2>
      <div class="how-grid">
        {product.howTo.map((item, index) => (
          <article>
            <span>{index + 1}</span>
            <strong>{item.step}</strong>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="review-block">
      <div class="review-heading">
        <div>
          <p class="eyebrow">What cat parents are saying</p>
          <h2>4.8 out of 5 based on 1,240 reviews</h2>
        </div>
        <a class="button secondary" href="#faq-panel">Write a review</a>
      </div>
      <article class="review-card">
        <p class="stars">★★★★★</p>
        <strong>{product.review.name}</strong>
        <p>{product.review.text}</p>
      </article>
    </section>

    <section class="faq-block" id="faq-panel">
      <h2>Frequently asked questions</h2>
      <div class="faq-list">
        {product.faqs.map((faq) => (
          <details>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="related-block">
      <div class="review-heading">
        <h2>You may also like</h2>
      </div>
      <div class="related-grid">
        {related.map((item) => (
          <a class="related-card" href={`/products/${item.slug}`}>
            <img src={item.heroImage} alt={item.name} />
            <div>
              <strong>{site.brand} {item.code}</strong>
              <p>${item.price.toFixed(2)}</p>
            </div>
            <span class="button secondary">Add to cart</span>
          </a>
        ))}
      </div>
    </section>
  </main>
  <SiteFooter brand={site.brand} />
</Layout>

<style>
  .product-page { padding: 36px 0 0; }
  .eyebrow, .breadcrumbs, .subtitle, .summary, .feature-row p, .trust-row p, .review-card p, .faq-list p { color: var(--muted); }
  .product-hero { display:grid; grid-template-columns: 1.03fr 0.97fr; gap:24px; align-items:start; }
  .gallery-card, .purchase-card, .trust-row article, .feature-row article, .story-block, .how-to, .review-card, .faq-list details, .related-card {
    background: rgba(255,250,244,0.9); border: 1px solid rgba(255,255,255,0.9); box-shadow: var(--shadow);
  }
  .gallery-card, .purchase-card, .story-block, .how-to, .review-card, .related-card { border-radius: 32px; }
  .gallery-main { overflow:hidden; border-radius: 28px; background: linear-gradient(180deg, var(--accent-soft), #fff8f0); }
  .gallery-main img { width:100%; height:100%; object-fit:cover; object-position:top; }
  .gallery-card { padding:20px; }
  .thumbs { display:grid; grid-template-columns: repeat(2, 1fr); gap:12px; margin-top:12px; }
  .thumb { border-radius: 18px; overflow:hidden; min-height:120px; background:#f4eadf; }
  .thumb img { width:100%; height:100%; object-fit:cover; object-position:top; }
  .purchase-card { padding:30px; }
  h1 { margin: 0; font-size: clamp(2.5rem,4vw,4.6rem); line-height:0.95; letter-spacing:-0.06em; }
  h1 span { color: var(--accent); }
  .subtitle { margin: 12px 0 8px; text-transform: capitalize; }
  .price-row { display:flex; gap:16px; align-items:center; margin-bottom:16px; }
  .price-row strong { font-size:2rem; }
  .selectors { display:grid; grid-template-columns: repeat(2, 1fr); gap:14px; margin: 24px 0; }
  .selectors label { display:block; font-size:0.88rem; color:#52604e; margin-bottom:8px; }
  .pill.alt { background: transparent; border:1px solid var(--line); }
  .actions { display:grid; gap:12px; }
  .subscribe { justify-content:center; }
  .quick-features { display:flex; flex-wrap:wrap; gap:10px; margin-top:20px; }
  .quick-features span, .ingredient-pills span {
    padding:10px 14px; border-radius:999px; background:var(--accent-soft); color:#27412a; font-weight:600;
  }
  .trust-row, .feature-row, .how-grid, .related-grid { display:grid; gap:16px; }
  .trust-row { grid-template-columns: repeat(3, 1fr); margin:24px 0; }
  .trust-row article, .feature-row article { padding:20px; border-radius:24px; }
  .feature-row { grid-template-columns: repeat(4, 1fr); margin-bottom:24px; }
  .story-block { display:grid; grid-template-columns: 0.95fr 1.05fr; gap:22px; padding:24px; margin-bottom:24px; }
  .story-block h2 { font-size: clamp(1.8rem,2.4vw,2.8rem); line-height:1.2; letter-spacing:-0.04em; }
  .ingredient-pills { display:flex; flex-wrap:wrap; gap:10px; margin-top:18px; }
  .story-images { display:grid; grid-template-columns: 1fr 1fr; gap:12px; }
  .story-images img { border-radius:24px; width:100%; height:100%; object-fit:cover; object-position:top; }
  .how-to, .faq-block, .review-block, .related-block { margin-bottom:24px; }
  .how-to { padding:24px; }
  .how-grid { grid-template-columns: repeat(4, 1fr); }
  .how-grid article { padding:18px; border-radius:24px; background:var(--surface); border:1px solid var(--line); }
  .how-grid span { width:40px; height:40px; display:flex;align-items:center;justify-content:center;border-radius:50%;background:var(--brand);color:#fff;font-weight:700;margin-bottom:14px; }
  .review-heading { display:flex; align-items:end; justify-content:space-between; gap:18px; margin-bottom:16px; }
  .review-card { padding:24px; }
  .stars { color:#d6a628; letter-spacing:0.1em; }
  .faq-list { display:grid; gap:14px; }
  .faq-list details { padding:20px 22px; border-radius:22px; }
  .faq-list summary { cursor:pointer; font-weight:700; }
  .related-grid { grid-template-columns: repeat(3, 1fr); }
  .related-card { padding:16px; display:grid; gap:16px; }
  .related-card img { border-radius:22px; width:100%; height:260px; object-fit:cover; object-position:top; background:linear-gradient(180deg, var(--accent-soft), #fff8f0); }
  @media (max-width: 1100px) {
    .product-hero, .story-block, .trust-row, .feature-row, .how-grid, .related-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 760px) {
    .product-hero, .selectors, .story-block, .trust-row, .feature-row, .how-grid, .related-grid, .story-images { grid-template-columns: 1fr; }
    .review-heading { flex-direction:column; align-items:start; }
  }
</style>
