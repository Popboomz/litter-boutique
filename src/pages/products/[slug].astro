---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { products, site } from '../../data/products';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const related = products.filter((item) => item.slug !== product.slug).slice(0, 3);
---

<Layout title={`Sigmö ${product.name} ${product.code}`} description={product.summary}>
  <SiteHeader brand={site.brand} />
  <main class="container product-page" style={`--accent:${product.accent};--accent-soft:${product.accentSoft};`}>
    <section class="product-hero">
      <div class="gallery-card">
        <div class="stage">
          <div class="bag">
            <div class="bag-top"></div>
            <div class="bag-label">
              <p>Sigmö</p>
              <strong>+{product.name}</strong>
              <span>{product.code}</span>
            </div>
            <div class="bag-foot">{product.subtitle}</div>
          </div>
          <div class="material a"></div>
          <div class="material b"></div>
          <div class="grains"></div>
        </div>
        <div class="thumbs">
          <div class="thumb"><div class="mini bag-mini"></div></div>
          <div class="thumb"><div class="mini bowl-mini"></div></div>
          <div class="thumb"><div class="mini material-mini"></div></div>
          <div class="thumb"><div class="mini cat-mini"></div></div>
        </div>
      </div>

      <div class="purchase-card">
        <p class="breadcrumbs">Home / Shop / Cat Litter / {product.name} {product.code}</p>
        <h1>{site.brand} +{product.name} <span>{product.code}</span></h1>
        <p class="subtitle">{product.subtitle}</p>
        <div class="price-row">
          <strong>${product.price.toFixed(2)}</strong>
          <span>★ 4.8 (1,240 reviews)</span>
        </div>
        <p class="summary">{product.summary}</p>

        <div class="selectors">
          <div>
            <label>Size</label>
            <span class="pill alt">{product.weight}</span>
          </div>
          <div>
            <label>Quantity</label>
            <span class="pill alt">− 1 +</span>
          </div>
        </div>

        <div class="actions">
          <a class="button" href="/products">Add to cart</a>
          <a class="pill subscribe" href="#">Subscribe & save 10%</a>
        </div>

        <div class="quick-features">
          {product.badges.map((badge) => <span>{badge}</span>)}
        </div>
      </div>
    </section>

    <section class="trust-row">
      <article><strong>Free shipping on orders $49+</strong><p>Delivered quickly and sustainably.</p></article>
      <article><strong>Subscribe & save</strong><p>Save 10% with recurring delivery.</p></article>
      <article><strong>Love it or return it</strong><p>30-day happiness guarantee.</p></article>
    </section>

    <section class="feature-row">
      {product.features.map((feature) => (
        <article>
          <strong>{feature.title}</strong>
          <p>{feature.text}</p>
        </article>
      ))}
    </section>

    <section class="story-block">
      <div>
        <p class="eyebrow">{product.visual.motif}</p>
        <h2>{product.description}</h2>
        <div class="ingredient-pills">
          {product.ingredients.map((item) => <span>{item}</span>)}
        </div>
      </div>
      <div class="story-images">
        <div class="story-art alt-a"></div>
        <div class="story-art alt-b"></div>
      </div>
    </section>

    <section class="how-to">
      <h2>How to use</h2>
      <div class="how-grid">
        {product.howTo.map((item, index) => (
          <article>
            <span>{index + 1}</span>
            <strong>{item.step}</strong>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="review-block">
      <div class="review-heading">
        <div>
          <p class="eyebrow">What cat parents are saying</p>
          <h2>4.8 out of 5 based on 1,240 reviews</h2>
        </div>
        <a class="button secondary" href="#faq-panel">Write a review</a>
      </div>
      <article class="review-card">
        <p class="stars">★★★★★</p>
        <strong>{product.review.name}</strong>
        <p>{product.review.text}</p>
      </article>
    </section>

    <section class="faq-block" id="faq-panel">
      <h2>Frequently asked questions</h2>
      <div class="faq-list">
        {product.faqs.map((faq) => (
          <details>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="related-block">
      <div class="review-heading">
        <h2>You may also like</h2>
      </div>
      <div class="related-grid">
        {related.map((item) => (
          <a class="related-card" href={`/products/${item.slug}`} style={`--card-accent:${item.accent};--card-soft:${item.accentSoft};`}>
            <div class="related-art">
              <div class="related-bag"></div>
              <div class="related-grains"></div>
            </div>
            <div>
              <strong>{site.brand} {item.code}</strong>
              <p>${item.price.toFixed(2)}</p>
            </div>
            <span class="button secondary">Add to cart</span>
          </a>
        ))}
      </div>
    </section>
  </main>
  <SiteFooter brand={site.brand} />
</Layout>

<style>
  .product-page { padding: 36px 0 0; }
  .eyebrow, .breadcrumbs, .subtitle, .summary, .feature-row p, .trust-row p, .review-card p, .faq-list p { color: var(--muted); }
  .product-hero { display:grid; grid-template-columns: 1.03fr 0.97fr; gap:24px; align-items:start; }
  .gallery-card, .purchase-card, .trust-row article, .feature-row article, .story-block, .how-to, .review-card, .faq-list details, .related-card {
    background: rgba(255,250,244,0.9); border: 1px solid rgba(255,255,255,0.9); box-shadow: var(--shadow);
  }
  .gallery-card, .purchase-card, .story-block, .how-to, .review-card, .related-card { border-radius: 32px; }
  .gallery-card { padding:20px; }
  .stage {
    position:relative; min-height:460px; border-radius:28px; overflow:hidden; background: linear-gradient(180deg, #fcf7f0 0%, var(--accent-soft) 100%);
  }
  .bag {
    position:absolute; left:34px; top:24px; width:48%; height:308px; border-radius:24px 24px 30px 30px; background: linear-gradient(180deg, #fffefb 0%, #f1e7da 100%); box-shadow: 0 20px 34px rgba(84,70,45,0.12);
  }
  .bag-top { height:56px; border-bottom:1px solid rgba(47,57,38,0.08); background: linear-gradient(180deg, #fffdf8 0%, #f5ede4 100%); }
  .bag-label { margin:20px; padding:18px; border-radius:18px; background: linear-gradient(180deg, var(--accentSoft, var(--accent-soft)), rgba(255,255,255,0.72)); }
  .bag-label p, .bag-foot { margin:0; color:#5f675d; }
  .bag-label strong { display:block; margin-top:6px; font-size:1.6rem; letter-spacing:-0.04em; }
  .bag-label span { display:block; margin-top:10px; font-size:2.4rem; font-weight:800; color:var(--accent); letter-spacing:-0.08em; }
  .bag-foot { margin:0 20px; text-transform:capitalize; }
  .grains {
    position:absolute; right:34px; bottom:30px; width:38%; height:120px; border-radius:50% 50% 30px 30px;
    background:
      radial-gradient(circle at 20% 30%, rgba(255,255,255,0.66) 0 5px, transparent 6px),
      radial-gradient(circle at 38% 52%, rgba(255,255,255,0.55) 0 4px, transparent 5px),
      radial-gradient(circle at 58% 32%, rgba(255,255,255,0.6) 0 4px, transparent 5px),
      radial-gradient(circle at 70% 55%, rgba(255,255,255,0.58) 0 4px, transparent 5px),
      radial-gradient(circle at 82% 35%, rgba(255,255,255,0.5) 0 4px, transparent 5px),
      linear-gradient(180deg, #d8cab0 0%, #bcac8e 100%);
  }
  .material { position:absolute; background: color-mix(in srgb, var(--accent) 55%, #8a704d); opacity:0.5; }
  .material.a { left:30px; bottom:56px; width:60px; height:60px; border-radius:14px; transform:rotate(-9deg); }
  .material.b { left:78px; bottom:26px; width:44px; height:44px; border-radius:50%; }
  .thumbs { display:grid; grid-template-columns: repeat(4, 1fr); gap:12px; margin-top:12px; }
  .thumb { min-height:120px; border-radius:18px; background: linear-gradient(180deg, #faf2e6 0%, #efe6d7 100%); position:relative; overflow:hidden; }
  .mini { position:absolute; inset:20px; border-radius:16px; }
  .bag-mini { background: linear-gradient(180deg, #fff 0%, var(--accent-soft) 100%); }
  .bowl-mini { background: radial-gradient(circle at 50% 45%, #d8cab0 0 34%, #bfaa8a 35% 100%); }
  .material-mini { background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 50%, #f1ecdf), var(--accent)); }
  .cat-mini { background: linear-gradient(180deg, #c7a073 0%, #a87d50 100%); border-radius:44% 44% 38% 38%; }
  .purchase-card { padding:30px; }
  h1 { margin: 0; font-size: clamp(2.5rem,4vw,4.6rem); line-height:0.95; letter-spacing:-0.06em; }
  h1 span { color: var(--accent); }
  .subtitle { margin: 12px 0 8px; text-transform: capitalize; }
  .price-row { display:flex; gap:16px; align-items:center; margin-bottom:16px; }
  .price-row strong { font-size:2rem; }
  .selectors { display:grid; grid-template-columns: repeat(2, 1fr); gap:14px; margin: 24px 0; }
  .selectors label { display:block; font-size:0.88rem; color:#52604e; margin-bottom:8px; }
  .pill.alt { background: transparent; border:1px solid var(--line); }
  .actions { display:grid; gap:12px; }
  .subscribe { justify-content:center; }
  .quick-features { display:flex; flex-wrap:wrap; gap:10px; margin-top:20px; }
  .quick-features span, .ingredient-pills span { padding:10px 14px; border-radius:999px; background:var(--accent-soft); color:#27412a; font-weight:600; }
  .trust-row, .feature-row, .how-grid, .related-grid { display:grid; gap:16px; }
  .trust-row { grid-template-columns: repeat(3, 1fr); margin:24px 0; }
  .trust-row article, .feature-row article { padding:20px; border-radius:24px; }
  .feature-row { grid-template-columns: repeat(4, 1fr); margin-bottom:24px; }
  .story-block { display:grid; grid-template-columns: 0.95fr 1.05fr; gap:22px; padding:24px; margin-bottom:24px; }
  .story-block h2 { font-size: clamp(1.8rem,2.4vw,2.8rem); line-height:1.2; letter-spacing:-0.04em; }
  .ingredient-pills { display:flex; flex-wrap:wrap; gap:10px; margin-top:18px; }
  .story-images { display:grid; grid-template-columns: 1fr 1fr; gap:12px; }
  .story-art { border-radius:24px; min-height:280px; background: linear-gradient(180deg, var(--accent-soft), #f8f1e5); }
  .story-art.alt-a { background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 28%, white), #f7efdf); }
  .story-art.alt-b { background: radial-gradient(circle at 45% 45%, #d8cab0 0 20%, #beaa8a 21% 48%, #efe5d7 49% 100%); }
  .how-to, .faq-block, .review-block, .related-block { margin-bottom:24px; }
  .how-to { padding:24px; }
  .how-grid { grid-template-columns: repeat(4, 1fr); }
  .how-grid article { padding:18px; border-radius:24px; background:var(--surface); border:1px solid var(--line); }
  .how-grid span { width:40px; height:40px; display:flex;align-items:center;justify-content:center;border-radius:50%;background:var(--brand);color:#fff;font-weight:700;margin-bottom:14px; }
  .review-heading { display:flex; align-items:end; justify-content:space-between; gap:18px; margin-bottom:16px; }
  .review-card { padding:24px; }
  .stars { color:#d6a628; letter-spacing:0.1em; }
  .faq-list { display:grid; gap:14px; }
  .faq-list details { padding:20px 22px; border-radius:22px; }
  .faq-list summary { cursor:pointer; font-weight:700; }
  .related-grid { grid-template-columns: repeat(3, 1fr); }
  .related-card { padding:16px; display:grid; gap:16px; }
  .related-art { position:relative; height:260px; border-radius:22px; background: linear-gradient(180deg, var(--card-soft), #fff9f0); overflow:hidden; }
  .related-bag { position:absolute; left:18px; top:18px; width:46%; height:180px; border-radius:18px; background: linear-gradient(180deg, #fff 0%, color-mix(in srgb, var(--card-soft) 70%, #f5eada) 100%); }
  .related-grains { position:absolute; right:18px; bottom:18px; width:36%; height:78px; border-radius:50% 50% 24px 24px; background: linear-gradient(180deg, #d8cab0 0%, #bcac8e 100%); }
  @media (max-width: 1100px) {
    .product-hero, .story-block, .trust-row, .feature-row, .how-grid, .related-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 760px) {
    .product-hero, .selectors, .story-block, .trust-row, .feature-row, .how-grid, .related-grid, .story-images, .thumbs { grid-template-columns: 1fr; }
    .review-heading { flex-direction:column; align-items:start; }
  }
</style>
